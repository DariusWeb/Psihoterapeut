{
  "name": "psihoterapeut",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview",
    "worker:test": "node worker/test.js && node worker/verify-token.test.js",
    "worker:preflight": "node worker/preflight.js",
    "worker:deploy": "npm run worker:test && npm run worker:preflight && wrangler deploy --config worker/wrangler.toml",
    "lint:oxlint": "oxlint . --fix -D correctness --ignore-path .gitignore",
    "lint:eslint": "eslint . --fix",
    "lint": "run-s lint:*",
    "format": "prettier --write src/"
  },
  "dependencies": {
    "@fontsource-variable/mulish": "^5.3.0",
    "@fontsource/libre-baskerville": "^5.3.0",
    "@lucide/vue": "^1.25.0",
    "firebase": "^12.17.1",
    "pinia": "^4.0.2",
    "posthog-js": "^1.413.3",
    "vue": "^3.5.40",
    "vue-i18n": "^11.4.7",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/eslint-config-prettier": "^10.1.0",
    "eslint": "^10.7.0",
    "eslint-plugin-oxlint": "^1.73.0",
    "eslint-plugin-vue": "^10.10.0",
    "javascript-obfuscator": "^5.5.0",
    "npm-run-all2": "^9.0.2",
    "oxlint": "~1.73.0",
    "prettier": "^3.9.5",
    "sass": "^1.101.0",
    "vite": "^8.1.5",
